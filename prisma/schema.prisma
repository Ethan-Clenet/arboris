// Schéma Prisma d'Arboris — catalogue de skills IA.
// Base PostgreSQL (Docker). Les textes bilingues (FR/EN) sont stockés
// dans des colonnes dédiées ; les listes (tech, compat, does, triggers) sont
// sérialisées en JSON et désérialisées dans la couche serveur (src/server).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

/// Catégorie d'un skill (Backend & API, Runtime & Core, …).
model Category {
  id      String  @id
  labelFr String
  labelEn String
  color   String
  icon    String
  sort    Int     @default(0)

  skills Skill[]

  @@map("categories")
}

/// Stack / technologie mise en avant sur la page « Premier pas ».
model Stack {
  id      String @id
  label   String
  icon    String
  color   String
  briefFr String
  briefEn String
  sort    Int    @default(0)

  // Relation many-to-many implicite avec les skills recommandés.
  skills Skill[]

  @@map("stacks")
}

/// Skill IA du catalogue.
model Skill {
  id            String  @id
  icon          String
  /// Score de sûreté 0–100 (SkillSpector) : 100 = sûr. Dérivé de 100 − risk_score.
  score         Int?
  /// Recommandation SkillSpector : SAFE | CAUTION | UNSAFE (ou équivalent).
  securityRecommendation String?
  /// Rapport JSON compact (issues + risk_assessment).
  securityReportJson     String  @default("null")
  scannedAt     DateTime?
  /// Mode de scan : static | semantic
  scanMode      String?
  tagFr         String
  tagEn         String
  actFr         String
  actEn         String
  // Listes sérialisées en JSON (tableaux de chaînes).
  techJson      String  @default("[]")
  compatJson    String  @default("[]")
  doesFrJson    String  @default("[]")
  doesEnJson    String  @default("[]")
  triggersFrJson String @default("[]")
  triggersEnJson String @default("[]")
  /// Contenu Markdown du skill (SKILL.md). Prioritaire sur le fichier disque.
  bodyMd        String?
  /// Éditeur / auteur (metadata.origin du SKILL.md), ex. ECC.
  publisher     String?
  sort          Int     @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  stacks Stack[]
  collections Collection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([score])
  @@index([publisher])
  @@map("skills")
}

/// Playlist / pack : skills et/ou slash commands à installer ensemble.
model Collection {
  id             String @id
  icon           String
  color          String @default("#43A047")
  labelFr        String
  labelEn        String
  briefFr        String
  briefEn        String
  /// featured | pack
  kind           String @default("featured")
  commandIdsJson String @default("[]")
  sort           Int    @default(0)

  skills Skill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collections")
}
