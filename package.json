{
  "name": "arboris",
  "version": "0.0.0",
  "private": true,
  "description": "Catalogue de skills IA — application web Arboris.",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "postinstall": "prisma generate && npm run build:cli",
    "generate:commands": "node scripts/generate-commands-bundle.mjs",
    "generate:phosphor": "tsx scripts/generate-phosphor-sprite.ts",
    "build": "npm run generate:commands && npm run generate:phosphor && prisma generate && vite build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lighthouse:ci": "node scripts/run-lhci.mjs",
    "a11y:ci": "node scripts/run-pa11y.mjs",
    "pa11y:ci": "node scripts/run-pa11y.mjs",
    "knip": "knip --no-config-hints",
    "knip:ci": "knip --include files,dependencies,unlisted,binaries,unresolved --no-config-hints",
    "semgrep": "semgrep scan --error --metrics=off --config=p/typescript --config=p/javascript --config=p/react src cli scripts prisma",
    "semgrep:ci": "semgrep scan --error --metrics=off --config=p/typescript --config=p/javascript --config=p/react --exclude=prisma/skills --exclude=prisma/skillspector-reports --exclude=node_modules --exclude=.output --exclude=dist --exclude=packages src cli scripts prisma",
    "cli:manifest": "tsx scripts/generate-cli-manifest.ts",
    "build:cli": "npm run cli:manifest && node scripts/build-cli.mjs",
    "publish:cli": "npm run build:cli && npm publish -w arboris-cli --access public && npm publish -w @rubix0270/arboris --access public",
    "db:generate": "prisma generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "docker compose up -d && prisma migrate deploy && prisma db seed",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:sync": "tsx scripts/sync-catalog.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "skills:scan": "node scripts/skillspector-scan.mjs",
    "skills:scan:sample": "node scripts/skillspector-scan.mjs --limit 5",
    "skills:scan:resolve": "node scripts/skillspector-resolve-version.mjs",
    "skills:scan:ci": "node scripts/skillspector-scan.mjs --resolve --no-db"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@prisma/client": "^6.19.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "^1.132.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@phosphor-icons/core": "^2.1.1",
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "knip": "^6.32.1",
    "pa11y-ci": "^4.1.1",
    "prisma": "^6.19.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "overrides": {
    "@tanstack/router-core": "1.171.34"
  }
}
