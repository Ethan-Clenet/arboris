# URL publique (SEO, sitemap, Open Graph)
SITE_URL="https://arboristhree.xyz"
VITE_SITE_URL="https://arboristhree.xyz"

# PostgreSQL via Docker (docker compose up -d)
DATABASE_URL="postgresql://arboris:arboris@localhost:5433/arboris"

# Racine du projet où écrire les skills (boutons Installer)
# Ex. /mnt/c/Users/monuser/mon-projet ou /root/mon-projet
ARBORIS_WORKSPACE_ROOT="/root/arboris"
