# URL publique (SEO, sitemap, Open Graph)
SITE_URL="https://arboristhree.xyz"
VITE_SITE_URL="https://arboristhree.xyz"

# PostgreSQL via Docker (docker compose up -d)
DATABASE_URL="postgresql://arboris:arboris@localhost:5433/arboris"

# Install locale (écriture disque) — DEV / Cloud Agent uniquement.
# Ne jamais définir ces variables sur le site public (Vercel) :
# les visiteurs utilisent ZIP + CLI.
ARBORIS_WORKSPACE_ROOT="/root/arboris"
ARBORIS_INSTALL_TOKEN="change-me-local-install-token-min-16-chars"
# Même valeur côté client (Vite) pour les boutons Installer
VITE_ARBORIS_INSTALL_TOKEN="change-me-local-install-token-min-16-chars"
