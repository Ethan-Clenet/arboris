# PostgreSQL via Docker (docker compose up -d)
DATABASE_URL="postgresql://arboris:arboris@localhost:5433/arboris"

# Secret de session (min. 32 caractères) — requis pour l'authentification.
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Compte admin créé/mis à jour par `npm run db:seed`
ADMIN_EMAIL="admin@arboris.local"
ADMIN_PASSWORD="ArborisAdmin2026!"
ADMIN_NAME="Admin Arboris"

# Racine du projet où écrire les skills (boutons Installer)
# Ex. /mnt/c/Users/monuser/mon-projet ou /root/mon-projet
ARBORIS_WORKSPACE_ROOT="/root/arboris"
